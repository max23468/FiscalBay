{
  "name": "fiscalbay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build && node scripts/check-bundle-size.mjs",
    "build:live": "cf build --mode live && node scripts/check-bundle-size.mjs",
    "build:placeholder": "pnpm --dir placeholder exec cf build --mode live",
    "cf:typegen": "cf workers types",
    "dev": "react-router dev",
    "doctor:react": "react-doctor --scope full --blocking warning .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "postinstall": "cf workers types",
    "release:cycle": "node scripts/release-cycle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:smoke": "E2E_BASE_URL=https://test.fiscalbay.it playwright test --project chromium --grep @smoke",
    "test:pages": "E2E_MATRIX=full node scripts/browser-tests.mjs --pages --browsers chromium,webkit",
    "test:mutation": "node scripts/mutation.mjs",
    "test:scripts": "node --test scripts/",
    "typecheck": "cf workers types && react-router typegen && tsc -b",
    "verify": "pnpm verify:copy && pnpm verify:repo && pnpm verify:pages && pnpm test:scripts && pnpm format:check && pnpm lint && pnpm typecheck && pnpm doctor:react && pnpm test && pnpm build:placeholder && pnpm build:live && pnpm build && pnpm verify:docs",
    "verify:tooling": "pnpm verify:copy && pnpm verify:repo && pnpm test:scripts && pnpm format:check && pnpm lint && pnpm verify:docs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:changed": "node scripts/classify-changes.mjs --run",
    "verify:copy": "node scripts/verify-copy.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:full": "pnpm verify && E2E_PREBUILT=1 E2E_MATRIX=full node scripts/browser-tests.mjs --browsers chromium,webkit",
    "verify:repo": "node scripts/verify-repo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.7",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "isbot": "5.2.2",
    "lucide-react": "1.54.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@playwright/test": "1.64.0",
    "@react-router/dev": "8.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cf": "1.0.0-beta.14",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react-doctor": "0.9.17",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": "26.11.1"
  },
  "packageManager": "pnpm@12.10.1"
}
