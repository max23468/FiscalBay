{
  "name": "fiscalbay",
  "version": "2.0.0-m0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf:typegen": "wrangler types",
    "dev": "react-router dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "postinstall": "wrangler types",
    "test": "vitest run",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@react-router/dev": "8.3.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": "26.8.2"
  },
