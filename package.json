{
  "name": "fiscalbay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build && node scripts/check-bundle-size.mjs",
    "build:live": "cf build --mode live && node scripts/check-bundle-size.mjs",
    "build:placeholder": "pnpm --dir placeholder exec cf build --mode live",
    "dev": "react-router dev",
    "doctor:react": "react-doctor --scope full --blocking warning .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "postinstall": "pnpm typegen",
    "release:cycle": "node scripts/release/release-cycle.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/coverage-report.mjs",
    "quality:knip": "knip",
    "benchmark": "node scripts/benchmark.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "E2E_BASE_URL=https://test.fiscalbay.it playwright test --project chromium --grep @smoke",
    "test:pages": "E2E_MATRIX=full node scripts/browser-tests.mjs --pages --browsers chromium,webkit",
    "test:mutation": "node scripts/mutation.mjs",
    "test:scripts": "node --test scripts/",
    "typecheck": "tsc -b",
    "typegen": "cf workers types && react-router typegen",
    "verify": "pnpm verify:unit && pnpm doctor:react && pnpm build:placeholder && pnpm build:live && pnpm build",
    "verify:build": "pnpm verify:unit && pnpm build",
    "verify:documents": "pnpm verify:copy && pnpm verify:docs",
    "verify:unit": "pnpm verify:tooling && pnpm typecheck && pnpm test:coverage",
    "verify:tooling": "pnpm verify:documents && pnpm typegen && pnpm verify:repo && pnpm verify:pages && pnpm test:scripts && pnpm format:check && pnpm lint && pnpm quality:knip",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:changed": "node scripts/classify-changes.mjs --run",
    "verify:copy": "node scripts/verify-copy.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:full": "pnpm verify && E2E_PREBUILT=1 E2E_MATRIX=full node scripts/browser-tests.mjs --browsers chromium,webkit",
    "verify:repo": "node scripts/verify-repo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.12",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "isbot": "5.2.2",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.0.3",
    "cf": "1.0.0-beta.18",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react-doctor": "0.9.18",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "26.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
