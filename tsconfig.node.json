{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "cloudflare.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "scripts/local-d1.mjs",
    "scripts/third-party-notices.mjs"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  }
}
