{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiscalbay-test",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "test.fiscalbay.it", "custom_domain": true }],
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://test.fiscalbay.it",
    "STRIPE_PRICE_MONTHLY": "price_1UHlnnJP7SSN14Zph79bnCQu",
    "STRIPE_PRICE_ANNUAL": "price_1UHlnnJP7SSN14Zpc0f7vZkS",
    "STRIPE_PRICE_LIFETIME": "price_1UHlngJP7SSN14ZpuFWGNO5w",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "EBAY_CLIENT_ID",
      "EBAY_CLIENT_SECRET",
      "EBAY_RUNAME",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiscalbay-test",
      "database_id": "d6e693f0-6156-44ea-a0fb-902aaccc72f1",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": ["noreply@fiscalbay.it"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
  "upload_source_maps": true,
  "env": {
    "production": {
      "name": "fiscalbay",
      "routes": [{ "pattern": "fiscalbay.it", "custom_domain": true }],
      "vars": {
        "APP_ORIGIN": "https://fiscalbay.it",
        "STRIPE_PRICE_MONTHLY": "",
        "STRIPE_PRICE_ANNUAL": "",
        "STRIPE_PRICE_LIFETIME": "",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "EBAY_CLIENT_ID",
          "EBAY_CLIENT_SECRET",
          "EBAY_RUNAME",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fiscalbay",
          "database_id": "fa2a79ad-fe72-4882-9cbb-c4009ffd5d8f",
          "migrations_dir": "migrations",
        },
      ],
      "send_email": [
        {
          "name": "AUTH_EMAIL",
          "allowed_sender_addresses": ["noreply@fiscalbay.it"],
        },
      ],
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.01,
        },
      },
    },
  },
}
