{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "cloudflare.config.ts",
        "telegram-worker/index.ts",
        "telegram-worker/vite.config.ts",
        "vitest.mutation.config.ts",
        "vitest.benchmark.config.ts",
