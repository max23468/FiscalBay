{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "env": { "node": true, "browser": true },
      "rules": { "no-undef": "error" }
    }
  ]
}
